rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.role == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'user';
      allow update: if request.auth != null
        && request.auth.uid == uid
        && resource.data.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == resource.data.role;
      allow delete: if false;

      match /favorites/{attractionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /trips/{tripId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.userId == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 100
          && request.resource.data.destination is string
          && request.resource.data.destination.size() >= 1
          && request.resource.data.destination.size() <= 100
          && request.resource.data.attractionIds is list;
        allow update: if request.auth != null
          && request.auth.uid == uid
          && resource.data.userId == uid
          && request.resource.data.userId == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 100
          && request.resource.data.destination is string
          && request.resource.data.destination.size() >= 1
          && request.resource.data.destination.size() <= 100
          && request.resource.data.attractionIds is list;
        allow delete: if request.auth != null
          && request.auth.uid == uid
          && resource.data.userId == uid;
      }
    }

    match /attractions/{attractionId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.category is string && request.resource.data.category.size() > 0
        && request.resource.data.description is string && request.resource.data.description.size() > 0
        && request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() > 0
        && request.resource.data.rating is number && request.resource.data.rating >= 0 && request.resource.data.rating <= 5;
      allow update: if isAdmin()
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.category is string && request.resource.data.category.size() > 0
        && request.resource.data.description is string && request.resource.data.description.size() > 0
        && request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() > 0
        && request.resource.data.rating is number && request.resource.data.rating >= 0 && request.resource.data.rating <= 5;
      allow delete: if isAdmin();

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.comment is string
          && request.resource.data.comment.size() >= 1
          && request.resource.data.comment.size() <= 2000;
        allow update: if request.auth != null
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.comment is string
          && request.resource.data.comment.size() >= 1
          && request.resource.data.comment.size() <= 2000;
        allow delete: if request.auth != null
          && resource.data.userId == request.auth.uid;
      }
    }
  }
}

